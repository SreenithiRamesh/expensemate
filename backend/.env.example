# PostgreSQL container configuration
POSTGRES_DB=expensemate
POSTGRES_USER=expensemate
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Base64-encoded secret containing at least 256 bits
JWT_SECRET=replace-with-a-secure-base64-secret

# Gemini is optional for the basic container test
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DAILY_LIMIT=10